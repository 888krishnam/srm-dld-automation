# ==============================================================================
# SRMIST DLD AUTOMATION - STUDENT & COURSE CONFIGURATION (TEMPLATE)
# Duplicate this file to .env and fill in your details:
#   cp .env.example .env
# ==============================================================================

# --- Student Details ---
# Name displayed on the generated PDF answer sheets
STUDENT_NAME="Your Name"

# Student Register Number / User ID (e.g. RAXXXXXXXXXXXXX)
REGISTER_NUMBER="RAXXXXXXXXXXXXX"

# Specialisation & Section (e.g. CSE AIML B, CSE Core C)
SPECIALISATION_SECTION="CSE Core C"

# Academic Department
DEPARTMENT="COMPUTER SCIENCE AND ENGINEERING"


# --- Course Details ---
# Course Code (e.g. 21CSE458T, 21CSE454T, 21CSE456T)
COURSE_CODE="21CSE458T"

# Course Name
COURSE_NAME="Wireless and Mobile Communication"

# Batch ID for the course (optional, auto-detected from token if omitted)
BATCH_ID="COURSECODE_BATCH"


# --- Authentication & AI Credentials ---
# Gemini API Key (get a free key from https://aistudio.google.com/)
# Supports multiple comma-separated keys for auto-rotation: "key1,key2"
GEMINI_API_KEY="your_gemini_api_key_here"

# SRMIST Portal JWT Authorization Token
# IMPORTANT: Open the specific course on the portal BEFORE copying this token!
# (To solve a different course later, open that course on the portal and run setup_profile.py again).
# How to get: Open course in Chrome -> Press F12 (DevTools) -> Network tab ->
# click any request -> Copy the value of the "Authorization" header:
AUTH_TOKEN="Bearer :your_jwt_token_here"
